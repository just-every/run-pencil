{
  "schema": 1,
  "projectId": "just-every/pencil",
  "name": "Pencil",
  "sourceRepository": "https://github.com/just-every/run-pencil",
  "license": "MIT",
  "deployment": {
    "target": "cloudflare-workers",
    "artifactFile": "rer-worker-artifact.json"
  },
  "operations": {
    "setup": "bash scripts/delivery/setup-build.sh",
    "build": "pnpm run build:delivery",
    "verify": "pnpm run verify",
    "artifact": "pnpm run build:delivery && node scripts/build-delivery-artifact.mjs",
    "recovery": "Preserve the private deployment receipt and ordered D1 migration ledger. Export before upgrades. Restore to an empty installation; imported historical responses never replay mail. Verify the owner, forms and retained responses before switching traffic."
  },
  "verification": {
    "sensitivePaths": [
      "src/base/operator-auth/**",
      "src/base/mail/**",
      "src/base/owner-claim/**",
      "src/core/features/auth/**",
      "src/core/features/management/**",
      "src/core/features/importing/**",
      "src/core/platform/**",
      "src/server.ts",
      "scripts/delivery/**",
      "rer-setup.json",
      "src/editor/**",
      "src/router.tsx",
      "src/routes/**"
    ],
    "migrationDirectories": [
      "migrations/core",
      "migrations/ext"
    ],
    "guidanceFiles": [
      "AGENTS.md",
      "CONTRACT.md",
      "OPERATIONS.md"
    ],
    "testPatterns": [
      "tests/runtime/**/*.worker.test.ts",
      "tests/e2e/**/*.spec.ts",
      "tests/admission/**/*.spec.ts",
      "scripts/delivery-artifact.check.mjs"
    ]
  },
  "setup": {
    "path": "rer-setup.json",
    "sha256": "fcfba8e66c2bbe329746990753d486005b74ce2d27d667e59d1f2cc05565203b"
  }
}
