{
  "schema": 1,
  "title": "Pencil",
  "groups": [
    {
      "id": "owner",
      "label": "First owner"
    },
    {
      "id": "mail",
      "label": "Hosted sign-in and response email"
    }
  ],
  "fields": [
    {
      "name": "SEED_ADMIN_EMAIL",
      "label": "Owner email",
      "help": "Use the actual first-owner mailbox. Local sign-in uses the private one-click RER_OPEN link.",
      "kind": "email",
      "required": true,
      "prefill": "account-email",
      "group": "owner"
    },
    {
      "name": "SESSION_SECRET",
      "label": "Session secret",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "SETUP_TOKEN",
      "label": "Setup token",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "MAIL_PROVIDER",
      "label": "Email provider",
      "help": "Hosted installs send real sign-in email and need Resend or SendGrid. Local dev/demo silently suppress email.",
      "kind": "select",
      "required": true,
      "default": "resend",
      "options": [
        {
          "value": "local",
          "label": "Local (suppress email)"
        },
        {
          "value": "resend",
          "label": "Resend"
        },
        {
          "value": "sendgrid",
          "label": "SendGrid"
        }
      ],
      "group": "mail"
    },
    {
      "name": "MAIL_FROM",
      "label": "Verified sender email",
      "help": "A plain noreply@ or no-reply@ address at a domain your email provider has verified. Sign-in email works from any verified sender, but response notifications are sent only from a noreply@ or no-reply@ address; with any other sender Pencil turns them off and says so on each flow's Results page.",
      "placeholder": "noreply@mail.example.com",
      "kind": "email",
      "required": true,
      "group": "mail"
    },
    {
      "name": "MAIL_API_KEY",
      "label": "Mail provider API key",
      "kind": "secret",
      "input": "entered",
      "ownerVisible": true,
      "required": false,
      "group": "mail",
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "required": true,
          "label": "Mail API key"
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "required": true,
          "label": "Mail API key"
        }
      ]
    },
    {
      "name": "IDENTITY_PROVIDER",
      "label": "Identity provider",
      "kind": "url",
      "required": false,
      "default": "",
      "help": "Optional Auth install. Leave empty to use email links.",
      "group": "owner"
    }
  ],
  "steps": [
    {
      "type": "owner-claim",
      "mode": "signed",
      "emailField": "SEED_ADMIN_EMAIL",
      "tokenField": "SETUP_TOKEN",
      "path": "/auth/owner-claim"
    }
  ],
  "dependencies": [
    {
      "interface": "oidc-provider@1",
      "optional": true,
      "cardinality": 1,
      "address": "IDENTITY_PROVIDER",
      "paths": [
        "/auth/oidc/auth/callback",
        "/auth/oidc/auth/logout"
      ]
    }
  ]
}
