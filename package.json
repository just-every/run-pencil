{
  "name": "pencil",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Pencil self-hosted adaptive form builder and feedback workspace.",
  "type": "module",
  "scripts": {
    "prepare:wrangler": "node scripts/prepare-wrangler-config.mjs",
    "db:migrate:local": "pnpm prepare:wrangler && CI=1 pnpm exec wrangler d1 migrations apply pencil-local --local --config wrangler.toml",
    "dev": "pnpm db:migrate:local && vite",
    "build": "pnpm prepare:wrangler && vite build && tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:load": "PENCIL_RUN_LOAD=1 PENCIL_LOAD_MODE=1 vitest run --config vitest.worker.config.ts tests/runtime/load.worker.test.ts --reporter=verbose",
    "test:e2e": "node scripts/run-browser-checks.mjs",
    "typecheck": "tsc -b",
    "verify:manifest": "node scripts/validate-manifest.mjs",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "verify:contract": "node --test scripts/contract-evidence.check.mjs scripts/contract-profile.check.mjs && node scripts/verify-contract-coverage.mjs",
    "verify:migrations": "node scripts/verify-release-migrations.mjs",
    "verify:preview": "node scripts/verify-preview-health.mjs",
    "verify:clean-clone": "node scripts/verify-clean-clone.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm test:worker && pnpm test:load && pnpm verify:data && pnpm verify:migrations && pnpm verify:manifest && pnpm verify:boundaries && pnpm build && pnpm verify:contract",
    "types:bindings": "pnpm prepare:wrangler && wrangler types",
    "setup": "node scripts/setup.mjs",
    "deploy": "node scripts/deploy.mjs",
    "export": "node scripts/deployment-data.mjs export",
    "import": "node scripts/deployment-data.mjs import",
    "verify:data": "node --test scripts/deployment-data.check.mjs scripts/distribution-data.check.mjs",
    "verify:contract:full": "node scripts/verify-contract-coverage.mjs full",
    "verify:publication": "node scripts/check-publication.mjs",
    "source:check": "node scripts/edition-authoring/cli.mjs check"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@hono/zod-validator": "^0.9.0",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-start": "1.168.50",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "lucide-react": "^0.542.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "ulid": "^3.0.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.54.5",
    "@cloudflare/vitest-plugin": "1.3.7",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/just-every/pencil"
  }
}
