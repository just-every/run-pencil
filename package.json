{
  "name": "pencil",
  "private": true,
  "version": "0.7.0",
  "license": "MIT",
  "description": "Pencil self-hosted adaptive form builder and feedback workspace.",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "rer dev",
    "build": "rer build",
    "preview": "rer preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:e2e": "node scripts/run-browser-checks.mjs",
    "typecheck": "tsc -b",
    "verify:manifest": "node scripts/validate-manifest.mjs",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "verify:contract": "node scripts/verify-contract-coverage.mjs",
    "verify:migrations": "node scripts/verify-release-migrations.mjs",
    "verify": "rer verify",
    "types:bindings": "wrangler types",
    "setup": "rer setup",
    "deploy": "rer deploy",
    "export": "rer export",
    "import": "rer import",
    "verify:data": "node --test --test-concurrency=2 scripts/deployment-data*.check.mjs",
    "verify:contract:full": "node scripts/verify-contract-coverage.mjs full",
    "verify:publication": "node scripts/verify-publication.mjs",
    "source:inspect": "node scripts/edition-authoring/cli.mjs inspect",
    "source:lock": "node scripts/edition-authoring/cli.mjs lock",
    "source:check": "node scripts/edition-authoring/cli.mjs check && node scripts/edition-authoring/cli.mjs verify-base --offline",
    "verify:setup": "node --test --test-concurrency=1 tests/local-cli/rer-journey.test.mjs tests/local-cli/dev-identity.test.mjs && playwright test --config playwright.local.config.ts --workers=1",
    "verify:base": "node scripts/verify-base-source.mjs",
    "verify:release": "PENCIL_RUN_LOAD=1 PENCIL_LOAD_MODE=1 vitest run --config vitest.release.config.ts && playwright test --config playwright.release.config.ts --workers=1",
    "build:app": "vite build && tsc -b",
    "verify:app": "pnpm typecheck && pnpm verify:base && pnpm verify:setup && pnpm verify:cli && pnpm verify:migrations && pnpm verify:manifest && pnpm verify:boundaries && pnpm run build:app && pnpm verify:admission && pnpm verify:contract",
    "verify:cli": "rer check --profile first-party",
    "reset": "rer reset",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "build:delivery": "node scripts/delivery/build.mjs",
    "verify:admission": "pnpm run build:delivery && node scripts/sync-integration.mjs --check && node --test scripts/delivery-artifact.check.mjs && playwright test --config playwright.admission.config.ts --workers=1",
    "integration:sync": "pnpm run build:delivery && node scripts/sync-integration.mjs --write",
    "test:docs": "playwright test tests/e2e/docs-site.spec.ts --workers=1"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@hono/zod-validator": "^0.9.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.13",
    "lucide-react": "^0.542.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js": "^1.15.0",
    "tailwind-merge": "^3.6.0",
    "ulid": "^3.0.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.54.5",
    "@cloudflare/vitest-plugin": "1.3.7",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@playwright/test": "^1.64.1",
    "@runeditrun/rer": "0.2.91",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "highlight.js": "10.7.3",
    "jsdom": "^26.1.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "react-markdown": "6.0.3",
    "read-excel-file": "9.3.12",
    "remark-gfm": "1.0.0",
    "sav-reader": "2.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.1"
  },
  "engines": {
    "node": "22.20.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/just-every/run-pencil"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "miniflare>sharp": "0.35.5",
      "miniflare>undici": "7.29.1",
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "source-map-js@<1.2.2": "1.2.2"
    }
  }
}
