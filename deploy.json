{
  "version": 1,
  "project": "just-every/pencil",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "secrets": [
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "SEED_ADMIN_EMAIL",
      "environment": "SEED_ADMIN_EMAIL"
    },
    {
      "binding": "MAIL_FROM",
      "environment": "MAIL_FROM"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY"
    }
  ],
  "crons": [
    "* * * * *"
  ],
  "originVar": "APP_ORIGIN",
  "vars": {
    "PENCIL_LOCAL_DEVELOPMENT": "false",
    "SEED_SAMPLE_DATA": "false",
    "MAIL_PROVIDER": "resend"
  }
}
