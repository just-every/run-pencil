{
  "schema": 1,
  "project": {
    "schema": 1,
    "projectId": "just-every/pencil",
    "name": "Pencil",
    "sourceRepository": "https://github.com/just-every/run-pencil",
    "license": "MIT",
    "deployment": {
      "target": "cloudflare-workers",
      "artifactFile": "rer-worker-artifact.json"
    },
    "operations": {
      "setup": "bash scripts/delivery/setup-build.sh",
      "build": "pnpm run build:delivery",
      "verify": "pnpm run verify",
      "artifact": "pnpm run build:delivery && node scripts/build-delivery-artifact.mjs",
      "recovery": "Preserve the private deployment receipt and ordered D1 migration ledger. Export before upgrades. Restore to an empty installation; imported historical responses never replay mail. Verify the owner, forms and retained responses before switching traffic."
    },
    "verification": {
      "sensitivePaths": [
        "src/base/operator-auth/**",
        "src/base/mail/**",
        "src/base/owner-claim/**",
        "src/core/features/auth/**",
        "src/core/features/management/**",
        "src/core/features/importing/**",
        "src/core/platform/**",
        "src/server.ts",
        "scripts/delivery/**",
        "rer-setup.json",
        "src/editor/**",
        "src/router.tsx",
        "src/routes/**"
      ],
      "migrationDirectories": [
        "migrations/core",
        "migrations/ext"
      ],
      "guidanceFiles": [
        "AGENTS.md",
        "CONTRACT.md",
        "OPERATIONS.md"
      ],
      "testPatterns": [
        "tests/runtime/**/*.worker.test.ts",
        "tests/e2e/**/*.spec.ts",
        "tests/admission/**/*.spec.ts",
        "scripts/delivery-artifact.check.mjs"
      ]
    }
  },
  "managed": {
    "workflowRef": "runeditrun/delivery/.github/workflows/trusted-build.yml@86c8b37399c901bffd9a240dbd1148a65ec83b34",
    "artifactFile": "rer-worker-artifact.json",
    "buildProfile": "project",
    "verificationProfiles": [
      "full"
    ],
    "pnpmVersion": "10.12.4"
  },
  "setup": {
    "manifestFile": "rer-setup.json"
  },
  "artifact": {
    "specInputs": {
      "publicVariableNames": [
        "APP_ORIGIN",
        "SEED_ADMIN_EMAIL",
        "MAIL_PROVIDER",
        "MAIL_FROM",
        "SEED_SAMPLE_DATA",
        "RER_MANAGEMENT_ORIGIN",
        "RER_INSTALLATION_ID",
        "RER_OWNER_CLAIM_ISSUER",
        "RER_OWNER_CLAIM_INSTALLATION_ID",
        "RER_OWNER_CLAIM_APP_ORIGIN",
        "RER_OWNER_CLAIM_PUBLIC_KEYS"
      ],
      "secretNames": [
        "SESSION_SECRET",
        "SETUP_TOKEN",
        "MAIL_API_KEY"
      ],
      "providerEffects": [
        "outbound-mail"
      ],
      "surfaces": {
        "app": {
          "path": "/app",
          "originVariable": "APP_ORIGIN",
          "readiness": [
            {
              "path": "/health",
              "statuses": [
                200
              ]
            }
          ]
        }
      },
      "extraMigrationDirectories": [
        {
          "binding": "DB",
          "path": "migrations/ext",
          "prefix": "ext-",
          "optional": true
        }
      ],
      "recovery": "Preserve the private deployment receipt and ordered D1 migration ledger. Export before upgrades. Restore to an empty installation; imported historical responses never replay mail. Verify the owner, forms and retained responses before switching traffic."
    }
  }
}
